---
// Starlight's hero, on the band of water that opens the team website's home page: a picture under
// a cyan-to-blue gradient, with waves along the bottom edge. The waves are the website's.
import Default from "@astrojs/starlight/components/Hero.astro";

const waves = [
  {
    id: "far",
    height: 156.16,
    opacity: 0.2,
    seconds: 10,
    d: "M168.240 49.056 C 167.712 49.086,165.444 49.188,163.200 49.281 C 143.488 50.103,115.787 53.364,79.520 59.131 C 73.332 60.115,66.777 61.400,52.240 64.479 C 26.261 69.981,13.893 72.165,1.000 73.526 L 0.000 73.631 0.000 114.896 L 0.000 156.160 200.000 156.160 L 400.000 156.160 400.000 114.865 L 400.000 73.570 399.240 73.668 C 392.614 74.526,376.370 75.136,367.081 74.876 C 346.460 74.299,330.374 71.907,290.160 63.438 C 245.005 53.929,225.053 50.905,197.200 49.349 C 193.076 49.119,171.017 48.895,168.240 49.056",
  },
  {
    id: "middle",
    height: 96.48,
    opacity: 0.3,
    seconds: 8,
    d: "M266.400 22.486 C 254.283 23.239,244.022 25.138,234.902 28.317 C 225.722 31.516,219.116 34.471,199.840 43.997 C 168.593 59.439,161.487 61.983,134.800 67.283 C 101.039 73.987,70.256 72.983,36.400 64.074 C 34.552 63.588,30.052 62.439,26.400 61.521 C 15.327 58.738,4.025 55.483,0.280 53.997 C 0.014 53.891,0.000 54.960,0.000 75.103 L 0.000 96.320 200.000 96.320 L 400.000 96.320 400.000 75.131 L 400.000 53.943 399.080 53.595 C 373.472 43.919,347.180 35.246,332.240 31.545 C 300.817 23.763,283.716 21.410,266.400 22.486",
  },
  {
    id: "near",
    height: 40.96,
    opacity: 1,
    seconds: 6,
    d: "M138.400 18.162 C 133.111 18.763,129.626 20.017,121.760 24.147 C 113.602 28.430,110.215 29.839,101.925 32.396 C 93.671 34.942,82.425 36.528,60.400 38.252 C 40.009 39.847,21.709 37.672,0.280 31.104 C 0.018 31.024,0.000 31.329,0.000 35.989 L 0.000 40.960 200.000 40.960 L 400.000 40.960 400.000 35.960 L 400.000 30.959 395.317 29.637 C 378.646 24.932,370.886 23.850,355.280 24.053 C 344.924 24.187,342.084 24.446,328.640 26.477 C 317.972 28.090,317.275 28.209,295.840 32.086 C 294.124 32.396,289.552 33.303,285.680 34.099 C 266.251 38.098,259.895 38.881,246.880 38.878 C 230.498 38.874,219.823 36.853,189.440 28.000 C 171.281 22.709,163.987 20.889,153.280 18.978 C 147.758 17.993,142.447 17.701,138.400 18.162",
  },
];
---

<div class="band">
  <Default />
  <div class="waves" aria-hidden="true">
    {waves.map(({ id, height, opacity, seconds, d }) => (
      <svg height={height} style={{ opacity, "animation-duration": `${seconds}s` }}>
        <defs>
          <pattern id={`wave-${id}`} width="400" {height} patternUnits="userSpaceOnUse">
            <path {d} fill="currentColor" fill-rule="evenodd" />
          </pattern>
        </defs>
        <rect width="100%" {height} fill={`url(#wave-${id})`} />
      </svg>
    ))}
  </div>
</div>

<style>
  /* The band is wider than the page by the width of the scrollbar, if there is one. */
  :global([data-has-hero] main) {
    overflow-x: clip;
  }
  .band {
    --sl-color-white: #fff;
    --sl-color-black: #000;
    --sl-color-gray-2: #e5e7eb;
    --sl-color-text-accent: #fff;
    position: relative;
    /* Fill the page, and meet the header: the content panel has 1.5rem of padding. */
    margin-inline: calc(50% - 50vw);
    margin-top: -1.5rem;
    background:
      linear-gradient(to bottom right, rgb(0 184 219 / 0.6), rgb(28 57 142 / 0.95)),
      url("/images/sim-front-camera.jpg") center / cover;
  }
  .band :global(.hero) {
    position: relative;
    z-index: 1;
    grid-template-columns: 100%;
    padding: clamp(4rem, 12vmin, 8rem) 1.25rem clamp(8rem, 20vmin, 13rem);
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.35);
  }
  .band :global(.stack) {
    text-align: center;
  }
  .band :global(.copy) {
    align-items: center;
  }
  .band :global(.actions) {
    justify-content: center;
    text-shadow: none;
  }
  .waves {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--sl-color-bg);
    pointer-events: none;
  }
  .waves::after {
    content: "";
    position: absolute;
    inset: auto 0 -1px;
    height: calc(2rem + 2px);
    background: currentColor;
  }
  svg {
    position: absolute;
    bottom: 2rem;
    width: calc(100% + 400px);
    animation: drift ease-in-out infinite alternate;
  }
  @keyframes drift {
    to {
      transform: translateX(-400px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    svg {
      animation: none;
    }
  }
</style>
