# Marlin V3's hardware and its network, spread into the vehicle by the deployment
# diagram, which fills in what runs on the Jetson. That diagram spreads
# _device-info at its root, for ${dvl.ip}.
...@_devices

switch: "Switch in the MEB\n${switch.cidr}"
router: "Router\n${router.ip}, DHCP ${router.dhcp}" {class: device}
jetson: "Jetson AGX Orin\nJetPack ${jetson.jetpack} (${jetson.os}, CUDA ${jetson.cuda})"

dvl <-> switch: "Ethernet (${dvl.ip})"
down-camera -> switch: "Ethernet (${down-camera.ip})"
router <-> switch
switch <-> jetson: "Ethernet (${jetson.ip}, ${jetson.interface})"
